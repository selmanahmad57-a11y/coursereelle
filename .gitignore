# Dépendances et build
node_modules/
.next/
out/
dist/

# Secrets — JAMAIS dans le repo
.env
.env.local
.env*.local

# Données — jamais versionnées
*.db
*.sqlite
/captures/
/uploads/
*.csv
*.xlsx

# Divers
.DS_Store
*.log
.vercel

# TypeScript / Next.js (généré, jamais versionné)
*.tsbuildinfo
next-env.d.ts
/build
/coverage

# Certificats et clés — jamais dans un repo public
*.pem
*.key

# Calibration — spécimens de tiers, jamais versionnés
# Les captures prêtées par des collègues sont des données de production : elles
# entrent, servent, et sont supprimées. Les gabarits candidats attendent une
# relecture avant d'entrer dans config/gabarits.json.
/calibration/

# Cache du moteur de lecture — les donnees de langue, telechargees puis gardees.
# Dossier separe de /calibration/ a dessein : ce cache est remonte dans le cache
# de l'executeur GitHub, et rien de ce qui vient d'un tiers ne doit y entrer.
/cache-moteur/
